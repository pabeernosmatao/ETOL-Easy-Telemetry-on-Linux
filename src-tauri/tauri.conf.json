{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ETOL",
  "version": "0.3.19",
  "identifier": "es.barbas.etol",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "ETOL · Easy Telemetry On Linux",
        "width": 1120,
        "height": 900,
        "minWidth": 940,
        "minHeight": 640,
        "resizable": true,
        "center": true,
        "theme": "Dark",
        "backgroundColor": "#0a0e13"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "appimage"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.png"
    ],
    "resources": [
      "payload"
    ],
    "category": "Utility",
    "shortDescription": "ETOL · Easy Telemetry On Linux",
    "longDescription": "ETOL detecta juegos de Steam, Proton y prefijos de Bottles (nativo o Flatpak), configura el pad HF8 y lanza la pila de telemetria de SimHub y CrewChief.",
    "linux": {
      "appimage": {
        "bundleMediaFramework": false
      }
    },
    "externalBin": [
      "binaries/etol"
    ]
  }
}
